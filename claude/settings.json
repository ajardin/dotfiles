{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose config *)",
      "mcp__claude_ai_Datadog__search_datadog_logs",
      "mcp__claude_ai_Datadog__analyze_datadog_logs",
      "mcp__claude_ai_Datadog__search_datadog_spans",
      "mcp__claude_ai_Datadog__get_datadog_trace",
      "mcp__claude_ai_Datadog__search_datadog_metrics",
      "mcp__claude_ai_Datadog__get_datadog_incident",
      "mcp__claude_ai_Datadog__load_datadog_skill",
      "mcp__claude_ai_Atlassian_MCP__getJiraIssue",
      "mcp__claude_ai_Atlassian_MCP__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian_MCP__getAccessibleAtlassianResources",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__get_notifications",
      "mcp__linear-server__get_issue_status",
      "mcp__linear-server__list_issue_statuses",
      "mcp__linear-server__list_issue_labels",
      "mcp__linear-server__get_team",
      "mcp__linear-server__list_teams",
      "mcp__linear-server__get_user",
      "mcp__linear-server__get_project",
      "mcp__linear-server__list_projects",
      "mcp__linear-server__list_cycles",
      "mcp__linear-server__list_custom_views",
      "mcp__linear-server__get_template",
      "mcp__linear-server__list_templates",
      "mcp__linear-server__get_document",
      "mcp__linear-server__list_documents"
    ],
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/secrets/**)",
      "Read(/**/credentials.json)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/command-history.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "awaySummaryEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "autoContinueAtUsageLimit": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
